# Dependencias (Se vuelven a descargar con npm install)
node_modules/
client/node_modules/
server/node_modules/

# Carpetas de Compilación (Se generan automáticamente en el hosting)
client/dist/
dist/

# Archivos de entorno y claves secretas
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos temporales de la base de datos
server/db.json.tmp
server/db.json.backup

# Logs y errores
npm-debug.log*
yarn-debug.log*
yarn-error.log*
LOG_ERROR_KRAKEN.txt

# IDEs y sistemas operativos
.DS_Store
Thumbs.db
.vscode/
.idea/
